# labcommand_msgs/MapBricks KIND_DELTA, CDR big endian: the same values as map_bricks_delta_le.hex
# with every multi-byte value reversed (bitmask bytes are uint8 and keep their order).
# Decode-only (encoders write little endian). Derived by hand.
00 00 00 00                 # encapsulation CDR_BE, options 0
00 00 00 04                 # pos 0   room_id length 4
6c 61 62 00                 # pos 4   "lab\0"
00 00 00 00 00 00 00 2b     # pos 8   map_epoch 43
00 00 00 00 00 00 00 0c     # pos 16  seq 12
68 ed 92 8a                 # pos 24  stamp.sec 1760400010
0e e6 b2 80                 # pos 28  stamp.nanosec 250000000
01                          # pos 32  kind KIND_DELTA
00 00 00 00 00 00 00        # pos 33  pad to 8
00 00 00 00 00 00 00 2a     # pos 40  base_epoch 42
3d 4c cc cd                 # pos 48  voxel_size 0.05
08                          # pos 52  brick_dim 8
00 00 00                    # pos 53  pad to 4
00 00 00 03                 # pos 56  brick_ijk length 3
ff ff 00 02 ff fd           # pos 60  brick_ijk (-1, 2, -3)
00 00                       # pos 66  pad to 4
00 00 00 40                 # pos 68  occ_bits length 64
01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 72
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 88
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 104
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80   # pos 120
00 00 00 40                 # pos 136 known_bits length 64
03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 140
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 156
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 172
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80   # pos 188
00 00 00 02                 # pos 204 removed_bricks_idx length 2
00 00 00 00                 # pos 208 removed_bricks_idx[0] 0
00 00 00 05                 # pos 212 removed_bricks_idx[1] 5
00                          # pos 216 compression COMPRESSION_NONE
