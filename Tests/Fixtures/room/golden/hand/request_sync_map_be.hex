# labcommand_msgs/RequestSync TOPIC_MAP_BRICKS, CDR big endian: the same values as
# request_sync_map_le.hex with every multi-byte value reversed. Decode-only (encoders write little
# endian). Derived by hand.
00 00 00 00                 # encapsulation CDR_BE, options 0
00 00 00 04                 # pos 0   room_id length 4
6c 61 62 00                 # pos 4   "lab\0"
00 00 00 00 00 00 00 2b     # pos 8   map_epoch 43
00 00 00 00 00 00 00 02     # pos 16  seq 2
68 ed 92 8a                 # pos 24  stamp.sec 1760400010
0e e6 b2 80                 # pos 28  stamp.nanosec 250000000
00 00 00 00 00 00 00 2b     # pos 32  since_epoch 43
00 00 00 00 00 00 00 0c     # pos 40  since_seq 12
00                          # pos 48  topic TOPIC_MAP_BRICKS
