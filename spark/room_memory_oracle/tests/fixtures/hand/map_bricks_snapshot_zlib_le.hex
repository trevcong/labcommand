# labcommand_msgs/MapBricks KIND_SNAPSHOT, COMPRESSION_ZLIB, CDR little endian. Derived by hand; see
# memory_status_le.hex. DEFLATE output is not canonical (Apple level 5 and Python level 6 emit
# different bytes for the same input), so this payload is a hand-built raw DEFLATE *stored* block
# (RFC 1951 §3.2.4): the uncompressed bytes appear verbatim and any inflater reads them, including
# Python's zlib.decompress(payload, -15). The test decodes these bytes, requires the encoder to
# match them up to the payload length, and requires the encoder's payload to inflate to the
# verbatim bytes at pos 73-340.
# Covers: two bricks packed struct-of-arrays (all brick_ijk, then all occ, then all known); an
# all-free brick (known full, occupied empty), which is sent because a missing brick means UNKNOWN.
00 01 00 00                 # encapsulation CDR_LE, options 0
04 00 00 00                 # pos 0   room_id length 4
6c 61 62 00                 # pos 4   "lab\0"
2b 00 00 00 00 00 00 00     # pos 8   map_epoch 43
0d 00 00 00 00 00 00 00     # pos 16  seq 13
8a 92 ed 68                 # pos 24  stamp.sec 1760400010
80 b2 e6 0e                 # pos 28  stamp.nanosec 250000000
01                          # pos 32  compression COMPRESSION_ZLIB
00                          # pos 33  kind KIND_SNAPSHOT
00 00 00 00 00 00           # pos 34  pad to 8
00 00 00 00 00 00 00 00     # pos 40  base_epoch 0
cd cc 4c 3d                 # pos 48  voxel_size 0.05
08                          # pos 52  brick_dim 8
00 00 00                    # pos 53  pad to 4
02 00 00 00                 # pos 56  n_bricks 2
00 00 00 00                 # pos 60  n_removed 0
11 01 00 00                 # pos 64  payload length 273 (5-byte stored-block header + 268)
01                          # pos 68  DEFLATE: BFINAL 1, BTYPE 00 (stored), rest of the byte unused
0c 01                       # pos 69  LEN 268 (134 x 2), little endian
f3 fe                       # pos 71  NLEN = ~268
ff ff 02 00 fd ff           # pos 73  brick 0 ijk (-1, 2, -3)
00 00 00 00 01 00           # pos 79  brick 1 ijk (0, 0, 1)
01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 85  brick 0 occ: voxel (0,0,0)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 101
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 117
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80   # pos 133 brick 0 occ: voxel (7,7,7)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 149 brick 1 occ: nothing occupied
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 165
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 181
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 197
03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 213 brick 0 known: voxels (0,0,0), (1,0,0)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 229
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 245
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80   # pos 261 brick 0 known: voxel (7,7,7)
ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff   # pos 277 brick 1 known: all 512 voxels (all free)
ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff   # pos 293
ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff   # pos 309
ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff   # pos 325
