# labcommand_msgs/MapBricks v2 KIND_DELTA, COMPRESSION_NONE, CDR little endian. Derived by hand; the
# values of map_bricks_delta_le.hex (legacy, kept) plus the trailing generation. Covers: the
# variable-length payload ends at pos 210, so 6 pad bytes align publisher_generation to 8.
00 01 00 00                 # encapsulation CDR_LE, options 0
04 00 00 00                 # pos 0   room_id length 4
6c 61 62 00                 # pos 4   "lab\0"
2b 00 00 00 00 00 00 00     # pos 8   map_epoch 43 (after the delta)
0c 00 00 00 00 00 00 00     # pos 16  seq 12
8a 92 ed 68                 # pos 24  stamp.sec 1760400010
80 b2 e6 0e                 # pos 28  stamp.nanosec 250000000
00                          # pos 32  compression COMPRESSION_NONE
01                          # pos 33  kind KIND_DELTA
00 00 00 00 00 00           # pos 34  pad to 8
2a 00 00 00 00 00 00 00     # pos 40  base_epoch 42
cd cc 4c 3d                 # pos 48  voxel_size 0.05
08                          # pos 52  brick_dim 8
00 00 00                    # pos 53  pad to 4
01 00 00 00                 # pos 56  n_bricks 1
02 00 00 00                 # pos 60  n_removed 2
8e 00 00 00                 # pos 64  payload length 142
ff ff 02 00 fd ff           # pos 68  payload brick_ijk (-1, 2, -3)
01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 74  occ bytes 0-15: voxel (0,0,0)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 90  occ bytes 16-31
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 106 occ bytes 32-47
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80   # pos 122 occ bytes 48-63: voxel (7,7,7)
03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 138 known bytes 0-15: voxels (0,0,0), (1,0,0)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 154 known bytes 16-31
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   # pos 170 known bytes 32-47
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80   # pos 186 known bytes 48-63: voxel (7,7,7)
00 00 00 00                 # pos 202 removed_bricks_idx[0] 0
05 00 00 00                 # pos 206 removed_bricks_idx[1] 5
00 00 00 00 00 00           # pos 210 pad to 8
00 44 04 e0 99 01 00 00     # pos 216 publisher_generation 1760400000000
