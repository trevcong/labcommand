# labcommand_msgs/Activity v2 (publisher_generation), CDR little endian. Derived by hand; the values of
# activity_le.hex (legacy, kept) plus the trailing generation. Covers: since_s ends at pos 84, so 4 pad
# bytes come before publisher_generation (96 bytes after the header, 100 on the wire).
00 01 00 00                 # encapsulation CDR_LE, options 0
04 00 00 00                 # pos 0   room_id length 4
6c 61 62 00                 # pos 4   "lab\0"
2b 00 00 00 00 00 00 00     # pos 8   map_epoch 43
15 00 00 00 00 00 00 00     # pos 16  seq 21
8a 92 ed 68                 # pos 24  stamp.sec 1760400010
80 b2 e6 0e                 # pos 28  stamp.nanosec 250000000
01                          # pos 32  active true
03                          # pos 33  sensors MID360 | JT128
02                          # pos 34  largest_sensor JT128
00                          # pos 35  pad to 4
03 00 00 00                 # pos 36  n_regions 3
04 03 02 01                 # pos 40  voxel_count 16909060 (0x01020304)
00 00 00 3f                 # pos 44  centroid.x 0.5
00 00 a0 3f                 # pos 48  centroid.y 1.25
00 00 80 3d                 # pos 52  centroid.z 0.0625
00 00 80 3e                 # pos 56  aabb min_x 0.25
00 00 80 3f                 # pos 60  aabb min_y 1.0
00 00 00 00                 # pos 64  aabb min_z 0.0
00 00 40 3f                 # pos 68  aabb max_x 0.75
00 00 c0 3f                 # pos 72  aabb max_y 1.5
00 00 00 3e                 # pos 76  aabb max_z 0.125
00 00 20 40                 # pos 80  since_s 2.5
00 00 00 00                 # pos 84  pad to 8
00 44 04 e0 99 01 00 00     # pos 88  publisher_generation 1760400000000
