01                          # pos 32  action ACCEPT
00 00 00 00 00 00 00        # pos 33  pad to 8
03 00 00 40 44 00 9e 19     # pos 40  event_id 1845913190400000003
01                          # pos 48  expected_state CONFIRMED
00 00 00 00 00 00 00        # pos 49  pad to 8
00 44 04 e0 99 01 00 00     # pos 56  expected_generation 1760400000000
01 00 00 00                 # pos 64  text length 1
00                          # pos 68  text "\0"
00 00 00                    # pos 69  pad to 4
07 00 00 00                 # pos 72  operator_id length 7
74 72 65 76 6f 72 00        # pos 76  operator_id "trevor\0"
00                          # pos 83  pad to 4
25 00 00 00                 # pos 84  action_id length 37
