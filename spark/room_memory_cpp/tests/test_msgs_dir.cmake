# Regression for the image build: test_interface used to bake <repo>/ros/labcommand_msgs.
# In the image that string is /ws/ros/labcommand_msgs, and the package is copied to
# /ws/src/labcommand_msgs, so the test threw and colcon test-result failed the image.
cmake_minimum_required(VERSION 3.20)

include("${CMAKE_CURRENT_LIST_DIR}/msgs_dir.cmake")

function(expect_marker resolved marker what)
  if(NOT EXISTS "${resolved}/marker")
    message(FATAL_ERROR "${what}: ${resolved} has no marker (expected ${marker})")
  endif()
  file(READ "${resolved}/marker" got)
  string(STRIP "${got}" got)
  if(NOT got STREQUAL "${marker}")
    message(FATAL_ERROR "${what}: marker '${got}', expected '${marker}' (${resolved})")
  endif()
endfunction()

function(plant dir marker)
  file(MAKE_DIRECTORY "${dir}/msg")
  file(WRITE "${dir}/CMakeLists.txt" "rosidl_generate_interfaces(${marker})\n")
  file(WRITE "${dir}/msg/Activity.msg" "string room_id\n")
  file(WRITE "${dir}/marker" "${marker}\n")
endfunction()

function(case_checkout_wins_over_sibling)
  set(root "${work}/checkout-only")
  set(tests "${root}/spark/room_memory_cpp/tests")
  plant("${root}/ros/labcommand_msgs" "checkout")
  plant("${root}/spark/labcommand_msgs" "sibling")
  file(MAKE_DIRECTORY "${tests}")
  room_memory_resolve_msgs_dir("${root}" "${tests}" "" got)
  expect_marker("${got}" "checkout" "checkout layout must win when both trees exist")
endfunction()

function(case_image_sibling_when_checkout_is_absent)
  set(root "${work}/image")
  set(tests "${root}/src/room_memory_cpp/tests")
  file(MAKE_DIRECTORY "${tests}")
  # A directory at the checkout path without CMakeLists.txt is not the package.
  file(MAKE_DIRECTORY "${root}/ros/labcommand_msgs/msg")
  file(WRITE "${root}/ros/labcommand_msgs/msg/Activity.msg" "string room_id\n")
  plant("${root}/src/labcommand_msgs" "image")
  room_memory_resolve_msgs_dir("${root}" "${tests}" "" got)
  expect_marker("${got}" "image" "image copy is the sibling of room_memory_cpp")
endfunction()

function(case_explicit_path_wins_and_is_not_rewritten)
  set(root "${work}/explicit")
  set(tests "${root}/src/room_memory_cpp/tests")
  plant("${root}/ros/labcommand_msgs" "checkout")
  plant("${root}/src/labcommand_msgs" "image")
  file(MAKE_DIRECTORY "${tests}")
  room_memory_resolve_msgs_dir("${root}" "${tests}" "${root}/src/labcommand_msgs" got)
  expect_marker("${got}" "image" "explicit ROOM_MEMORY_MSGS_DIR must win over the checkout")
  # The image passes this absolute path. It must not be rewritten when the tree is absent.
  room_memory_resolve_msgs_dir("/ws" "/ws/src/room_memory_cpp/tests" "/ws/src/labcommand_msgs" verbatim)
  if(NOT verbatim STREQUAL "/ws/src/labcommand_msgs")
    message(FATAL_ERROR "explicit image path was rewritten to '${verbatim}'")
  endif()
endfunction()

function(case_missing_layouts_name_the_checkout)
  set(root "${work}/absent")
  set(tests "${root}/src/room_memory_cpp/tests")
  file(MAKE_DIRECTORY "${tests}")
  room_memory_resolve_msgs_dir("${root}" "${tests}" "" got)
  if(NOT got STREQUAL "${root}/ros/labcommand_msgs")
    message(FATAL_ERROR "missing layouts should name the checkout path, got '${got}'")
  endif()
  room_memory_msgs_dir_usable("${got}" ok)
  if(ok)
    message(FATAL_ERROR "absent checkout path was reported usable")
  endif()
endfunction()

function(case_usable_predicate)
  set(root "${work}/usable")
  plant("${root}/ok" "ok")
  room_memory_msgs_dir_usable("${root}/ok" ok)
  room_memory_msgs_dir_usable("${root}/missing" bad)
  if(NOT ok)
    message(FATAL_ERROR "planted package was not usable")
  endif()
  if(bad)
    message(FATAL_ERROR "missing package was usable")
  endif()
endfunction()

# This source tree: the checkout on a Mac, the copied sibling inside the image.
function(case_this_tree)
  get_filename_component(live_repo "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
  room_memory_resolve_msgs_dir("${live_repo}" "${CMAKE_CURRENT_LIST_DIR}" "" live)
  room_memory_msgs_dir_usable("${live}" live_ok)
  if(NOT live_ok)
    message(FATAL_ERROR "this tree resolved to an unusable labcommand_msgs: ${live}")
  endif()
  if(EXISTS "${live_repo}/ros/labcommand_msgs/CMakeLists.txt")
    if(NOT live STREQUAL "${live_repo}/ros/labcommand_msgs")
      message(FATAL_ERROR "checkout tree should resolve to ros/labcommand_msgs, got ${live}")
    endif()
  else()
    get_filename_component(sibling "${CMAKE_CURRENT_LIST_DIR}/../../labcommand_msgs" ABSOLUTE)
    if(NOT live STREQUAL "${sibling}")
      message(FATAL_ERROR "colcon tree should resolve to the sibling package, got ${live}")
    endif()
  endif()
endfunction()

function(require_contains text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "${what}: missing [${needle}]")
  endif()
endfunction()

function(case_cmakelists_uses_the_resolver)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/CMakeLists.txt" lists)
  require_contains("${lists}" [[include("${CMAKE_CURRENT_SOURCE_DIR}/msgs_dir.cmake")]] "CMakeLists.txt")
  require_contains("${lists}" [[room_memory_resolve_msgs_dir("${REPO_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}"]] "CMakeLists.txt")
  require_contains("${lists}" [[room_memory_require_msgs_dir("${ROOM_MEMORY_MSGS_DIR}")]] "CMakeLists.txt")
  require_contains("${lists}" [[ROOM_MEMORY_MSGS_DIR="${ROOM_MEMORY_MSGS_DIR}"]] "CMakeLists.txt")
  string(FIND "${lists}" [[ROOM_MEMORY_MSGS_DIR="${REPO_ROOT}/ros/labcommand_msgs"]] baked)
  if(NOT baked EQUAL -1)
    message(FATAL_ERROR "test_interface still bakes the checkout path; the image's REPO_ROOT is /ws")
  endif()
endfunction()

# The cmake-arg must be the tree the Dockerfile copies, not a second hardcoded guess.
function(case_dockerfile_passes_the_copy_destination)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/../Dockerfile" docker)
  string(REPLACE "\r" "" docker "${docker}")
  string(REGEX MATCH "WORKDIR[ \t]+([^ \t\r\n]+)" workdir_hit "${docker}")
  if(NOT workdir_hit)
    message(FATAL_ERROR "Dockerfile has no WORKDIR")
  endif()
  set(workdir "${CMAKE_MATCH_1}")
  string(REGEX MATCHALL "COPY[ \t]+([^ \t\r\n]*labcommand_msgs[^ \t\r\n]*)[ \t]+([^ \t\r\n]+)" copies "${docker}")
  list(LENGTH copies copy_n)
  if(NOT copy_n EQUAL 1)
    message(FATAL_ERROR "Dockerfile must COPY labcommand_msgs exactly once, found ${copy_n}")
  endif()
  string(REGEX MATCH "COPY[ \t]+([^ \t\r\n]*labcommand_msgs[^ \t\r\n]*)[ \t]+([^ \t\r\n]+)" ignored "${docker}")
  set(copy_src "${CMAKE_MATCH_1}")
  set(copy_dest "${CMAKE_MATCH_2}")
  if(NOT copy_src STREQUAL "ros/labcommand_msgs")
    message(FATAL_ERROR "image context should copy ros/labcommand_msgs, got '${copy_src}'")
  endif()
  if(copy_dest MATCHES "^/")
    set(copied "${copy_dest}")
  else()
    set(copied "${workdir}/${copy_dest}")
  endif()
  string(REGEX REPLACE "/+" "/" copied "${copied}")
  string(REGEX REPLACE "/$" "" copied "${copied}")
  string(REGEX MATCHALL "-DROOM_MEMORY_MSGS_DIR=([^ \t\r\n]+)" flags "${docker}")
  list(LENGTH flags flag_n)
  if(NOT flag_n EQUAL 1)
    message(FATAL_ERROR "Dockerfile must pass -DROOM_MEMORY_MSGS_DIR exactly once, found ${flag_n}")
  endif()
  string(REGEX MATCH "-DROOM_MEMORY_MSGS_DIR=([^ \t\r\n]+)" ignored "${docker}")
  set(passed "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "/$" "" passed "${passed}")
  if(NOT passed STREQUAL copied)
    message(FATAL_ERROR
      "Dockerfile passes ROOM_MEMORY_MSGS_DIR=${passed} but copies labcommand_msgs to ${copied}")
  endif()
endfunction()

if(DEFINED ENV{TMPDIR} AND NOT "$ENV{TMPDIR}" STREQUAL "")
  set(scratch "$ENV{TMPDIR}")
else()
  set(scratch "/tmp")
endif()
string(REGEX REPLACE "/$" "" scratch "${scratch}")
set(work "${scratch}/room-memory-msgs-dir-regression")
file(REMOVE_RECURSE "${work}")

case_checkout_wins_over_sibling()
case_image_sibling_when_checkout_is_absent()
case_explicit_path_wins_and_is_not_rewritten()
case_missing_layouts_name_the_checkout()
case_usable_predicate()
case_this_tree()
case_cmakelists_uses_the_resolver()
case_dockerfile_passes_the_copy_destination()

file(REMOVE_RECURSE "${work}")
